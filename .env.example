# Set these as OS environment variables. .env is not loaded automatically by Python.
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
# VIEWER_USER=viewer
# VIEWER_PASSWORD=another-long-unique-password
# FRANCHISEOPS_DB=/absolute/path/franchiseops.db
# OLLAMA_MODEL=your-installed-model-name
